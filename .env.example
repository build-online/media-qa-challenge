# Base URL of the application under test
BASE_URL=https://media.tithelyqa.com

# JWT from session_token cookie (DevTools → Application → Cookies)
SESSION_TOKEN=your_session_token_value

# Laravel session cookie (DevTools → Application → Cookies → tithely_media_staging_session)
LARAVEL_SESSION=your_tithely_media_staging_session_value

# XSRF token (DevTools → Application → Cookies → XSRF-TOKEN)
XSRF_TOKEN=your_xsrf_token_value
